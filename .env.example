APP_NAME="EventBomb"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=eventbomb_v2
DB_USERNAME=root
DB_PASSWORD=

# Laravel Reverb (built-in websockets — no external service needed)
BROADCAST_DRIVER=reverb
REVERB_APP_ID=eventbomb
REVERB_APP_KEY=eventbomb-key
REVERB_APP_SECRET=eventbomb-secret
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

CACHE_DRIVER=file
FILESYSTEM_DISK=public
# Where uploads, logos and QR codes live: "public" (local) or "s3"
MEDIA_DISK=public
QUEUE_CONNECTION=database
SESSION_DRIVER=database
SESSION_LIFETIME=120

# V3 placeholders (leave blank)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-central-1
AWS_BUCKET=showmeonscreen
AWS_USE_PATH_STYLE_ENDPOINT=false
# CLOUDFRONT_URL=
# COGNITO_CLIENT_ID=
# COGNITO_CLIENT_SECRET=
# COGNITO_REDIRECT_URI=
# COGNITO_USER_POOL_ID=
